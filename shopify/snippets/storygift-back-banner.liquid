{% comment %}
  StoryGift Navigation Banner
  
  Add this snippet to your Shopify theme to show a "Back to StoryGift" 
  button on native Shopify pages (account, login, orders, etc.)
  
  Installation:
  1. Go to Shopify Admin → Online Store → Themes → Edit Code
  2. Under "Snippets", click "Add a new snippet"
  3. Name it: storygift-back-banner
  4. Paste this entire file content
  5. Then in layout/theme.liquid, add this line right after <body>:
     {% render 'storygift-back-banner' %}
{% endcomment %}

{% comment %} 
  Only show on native Shopify pages (not on the story-creator page 
  where the React app has its own navbar) 
{% endcomment %}
{% unless template == 'page.story-creator' %}

<style>
  .sg-back-banner {
    background: linear-gradient(135deg, #FF6B9D 0%, #FF8FB1 100%);
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    position: sticky;
    top: 0;
    z-index: 9999;
    box-shadow: 0 2px 8px rgba(255, 107, 157, 0.3);
    font-family: 'Nunito', sans-serif;
  }

  .sg-back-banner__text {
    color: white;
    font-size: 14px;
    font-weight: 600;
    margin: 0;
  }

  .sg-back-banner__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: white;
    color: #FF6B9D;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    border: none;
    cursor: pointer;
    font-family: 'Nunito', sans-serif;
  }

  .sg-back-banner__btn:hover {
    background: #FFF0F5;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    color: #FF6B9D;
    text-decoration: none;
  }

  .sg-back-banner__btn svg {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 480px) {
    .sg-back-banner {
      padding: 8px 12px;
      gap: 8px;
    }
    .sg-back-banner__text {
      font-size: 12px;
    }
    .sg-back-banner__btn {
      font-size: 12px;
      padding: 5px 12px;
    }
  }
</style>

<div class="sg-back-banner">
  <p class="sg-back-banner__text">✨ Create magical personalized storybooks!</p>
  <a href="/pages/create-story" class="sg-back-banner__btn">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
    Back to StoryGift
  </a>
</div>

{% endunless %}
