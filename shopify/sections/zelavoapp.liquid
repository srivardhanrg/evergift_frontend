{% comment %}
  StoryGift App Section

  Performance optimizations:
  - Preload critical JS/CSS bundles
  - Preload top theme cover images (breaks waterfall)
  - Preconnect to R2 CDN and Google Fonts
  - Instant loading state (replaced by Shadow DOM)
  - Defensive CSS to hide Shopify chrome

  Update bundle hashes when deploying new builds:
  - JS: index-[hash].js
  - CSS: index-[hash].css
{% endcomment %}

{% comment %} ============================================
   CONFIGURATION - Update these on each deploy
   ============================================ {% endcomment %}
{% assign js_bundle = "index-EpW5D0Qi.js" %}
{% assign css_bundle = "index-HkA66jzO.css" %}
{% assign r2_base = "https://pub-eab76058d817412b9c6c9726ff8ae49e.r2.dev/Magictales" %}

{% comment %} ============================================
   PRECONNECT & PRELOAD HINTS (Critical for performance)
   ============================================ {% endcomment %}

<!-- Preconnect to critical origins -->
<link rel="preconnect" href="https://pub-eab76058d817412b9c6c9726ff8ae49e.r2.dev" crossorigin>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://magictales-backend.onrender.com" crossorigin>

<!-- Preload critical bundles -->
<link rel="modulepreload" href="{{ r2_base }}/assets/{{ js_bundle }}">

<!-- Preload theme cover images (top 4 visible on load) -->
<link rel="preload" as="image" href="{{ r2_base }}/theme_covers/enchanted_forest_cover.webp" fetchpriority="high">
<link rel="preload" as="image" href="{{ r2_base }}/theme_covers/magic_castle_cover.webp">
<link rel="preload" as="image" href="{{ r2_base }}/theme_covers/space.webp">
<link rel="preload" as="image" href="{{ r2_base }}/theme_covers/mighty_guardian.png.webp">

{% comment %} ============================================
   DEFENSIVE CSS - Hide Shopify chrome when app is active
   ============================================ {% endcomment %}
<style>
  /* Hide Shopify header/footer when our app is present */
  body:has(#zelavo-app) #header-group,
  body:has(#zelavo-app) .shopify-section-group-header-group,
  body:has(#zelavo-app) .shopify-section-group-footer-group,
  body:has(#zelavo-app) .announcement-bar,
  body:has(#zelavo-app) footer,
  body:has(#zelavo-app) #shopify-section-footer {
    display: none !important;
  }

  /* FIX 1: Kill Shopify mobile drawers/overlays that block touches.
     These are the primary cause of mobile navigation failure.
     Shopify themes render invisible fixed-position drawer elements
     (menu, cart, search) that capture touch events on mobile even
     when visually "closed". */
  body:has(#zelavo-app) header,
  body:has(#zelavo-app) .header-wrapper,
  body:has(#zelavo-app) menu-drawer,
  body:has(#zelavo-app) cart-drawer,
  body:has(#zelavo-app) .drawer,
  body:has(#zelavo-app) .menu-drawer,
  body:has(#zelavo-app) .cart-drawer,
  body:has(#zelavo-app) details-modal,
  body:has(#zelavo-app) details-disclosure,
  body:has(#zelavo-app) .cart-notification,
  body:has(#zelavo-app) .predictive-search,
  body:has(#zelavo-app) .site-nav-mobile,
  body:has(#zelavo-app) .mobile-nav {
    display: none !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }

  /* Hide ALL Shopify sections except our app section */
  body:has(#zelavo-app) .shopify-section:not(.storygift-section) {
    display: none !important;
    pointer-events: none !important;
  }

  body:has(#zelavo-app) #MainContent {
    padding: 0 !important;
    margin: 0 !important;
  }

  body:has(#zelavo-app) {
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: hidden !important;
  }

  /* FIX 2: Elevate app container above any surviving Shopify elements,
     enable fast-tap for mobile, remove tap highlight */
  #zelavo-app {
    display: block;
    min-height: 100vh;
    width: 100%;
    position: relative;
    z-index: 100;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  /* Instant loading state styles */
  #zelavo-app-loader {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FAFAFA;
    z-index: 9999;
    transition: opacity 0.2s ease-out;
  }

  #zelavo-app-loader.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .loader-content {
    text-align: center;
    font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .loader-spinner {
    width: 48px;
    height: 48px;
    border: 3px solid #FFF0F5;
    border-top-color: #FF6B9D;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 16px;
  }

  .loader-text {
    color: #6B7280;
    font-size: 14px;
    font-weight: 500;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

{% comment %} ============================================
   APP CONTAINER
   ============================================ {% endcomment %}
<div id="zelavo-app"
     data-customer-id="{% if customer %}{{ customer.id }}{% else %}null{% endif %}"
     data-customer-email="{{ customer.email }}"
     data-shop-domain="{{ shop.domain }}"
     data-country-code="{{ localization.country.iso_code }}"
     data-backend-url="https://magictales-backend.onrender.com"
     data-css-url="{{ r2_base }}/assets/{{ css_bundle }}">

  {% comment %} Instant loading state - React will dismiss this {% endcomment %}
  <div id="zelavo-app-loader">
    <div class="loader-content">
      <div class="loader-spinner"></div>
      <p class="loader-text">Loading your story creator...</p>
    </div>
  </div>
</div>

{% comment %} ============================================
   APP BUNDLE (creates Shadow DOM)
   ============================================ {% endcomment %}
<script type="module" src="{{ r2_base }}/assets/{{ js_bundle }}"></script>

{% comment %} ============================================
   LOADER DISMISSAL
   React dispatches 'storygift-ready' when mounted
   ============================================ {% endcomment %}
<script>
  // Listen for React app ready signal
  window.addEventListener('storygift-ready', function() {
    var loader = document.getElementById('zelavo-app-loader');
    if (loader) {
      loader.classList.add('hidden');
      // Remove from DOM after fade transition
      setTimeout(function() { loader.remove(); }, 200);
    }
  });

  // FIX 3: Fallback hides AND removes loader from DOM after 5 seconds
  // Prevents the fixed z-9999 element from blocking touches on slow networks
  setTimeout(function() {
    var loader = document.getElementById('zelavo-app-loader');
    if (loader && !loader.classList.contains('hidden')) {
      console.warn('[StoryGift] Loader timeout - React may have failed to mount');
      loader.classList.add('hidden');
      setTimeout(function() { loader.remove(); }, 300);
    }
  }, 5000);

  // FIX 4: JS defense - neutralize Shopify drawer elements that may
  // have been injected dynamically after CSS rules applied
  document.addEventListener('DOMContentLoaded', function() {
    var selectors = 'menu-drawer, cart-drawer, details-modal, .drawer, ' +
      '.header-wrapper, header, .cart-notification, .predictive-search';
    var els = document.querySelectorAll(selectors);
    els.forEach(function(el) {
      if (!el.closest('#zelavo-app')) {
        el.style.setProperty('display', 'none', 'important');
        el.style.setProperty('pointer-events', 'none', 'important');
      }
    });
  });
</script>

{% schema %}
{
  "name": "StoryGift App",
  "tag": "section",
  "class": "storygift-section",
  "settings": []
}
{% endschema %}
